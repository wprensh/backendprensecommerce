<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PrensEcommerce.Api</RootNamespace>
    <UserSecretsId>prens-ecommerce-api</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistencia: EF Core 9 + PostgreSQL -->
    <PackageReference Include="Anthropic" Version="13.5.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Caché: Redis como L2 de HybridCache + IDistributedCache -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="9.10.0" />

    <!-- API -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.22" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />

    <!-- Health checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrensEcommerce.Api.Tests" />
  </ItemGroup>

</Project>
